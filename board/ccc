#!/bin/bash
# ccc: opens the CCC board in a browser window of its own.
#   ccc        starts the server when needed, asks whether to close this terminal,
#                      then opens the board
#   ccc stop   stops the server; the terminals and background sessions go on in
#              CCC's keeper, and the next ccc finds them again
#   ccc stop --all  stops the keeper too, which ends them; it asks first while any
#              run (ccc stop --all --force does not ask)
# Exits 100 when the person asked to close the terminal: the ccc function in
# ~/.zshrc then exits the shell, which closes the terminal window cleanly.
set -uo pipefail

PORT="${CCC_PORT:-8765}"
URL="http://127.0.0.1:${PORT}/"
BOARD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SERVER="$BOARD_DIR/serve.py"
KEEPER="$BOARD_DIR/keeper.py"
LOG="$HOME/.claude/ccc/server.log"
CLOSE_TERMINAL=100

is_up() {
  curl -fsS --max-time 1 "${URL}api/health" 2>/dev/null | grep -q '"app": "ccc"'
}

is_port_taken() {
  lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1
}

start_server() {
  mkdir -p "$(dirname "$LOG")"
  CCC_PORT="$PORT" nohup python3 "$SERVER" >>"$LOG" 2>&1 </dev/null &
  disown
  for _ in $(seq 1 30); do
    is_up && return 0
    sleep 0.1
  done
  echo "The board server did not start. See $LOG" >&2
  return 1
}

# how many terminals (shells and background sessions) still run in CCC's keeper
running_terminals() {
  python3 "$KEEPER" count 2>/dev/null || echo 0
}

# yes only when the person says so; with no one at the keyboard to ask, it is no
sure_to_end_terminals() {
  local count="$1" answer word="terminals"
  [ "$count" = "1" ] && word="terminal"
  echo "Are you sure? This will terminate all active terminals: $count $word running in CCC (shells and background Claude sessions), and anything running in them."
  if [ ! -t 0 ]; then
    echo "Nothing was stopped. Run 'ccc stop --all --force' to stop it anyway." >&2
    return 1
  fi
  read -r -n 1 -p "Stop them? (y/n) " answer
  echo
  [[ "$answer" =~ ^[yY]$ ]]
}

stop_server() {
  local pid
  pid="$(lsof -t -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1)"
  if [ -n "$pid" ] && is_up; then
    kill "$pid"
    echo "Board server stopped."
  else
    echo "Board server was not running."
  fi
}

# ccc stop [--all] [--force], in any order
stop() {
  local all=false force=false word count
  for word in "$@"; do
    case "$word" in
      --all) all=true ;;
      --force) force=true ;;
      *)
        echo "Usage: ccc [stop [--all] [--force]]" >&2
        return 2
        ;;
    esac
  done
  if ! $all; then
    stop_server
    count="$(running_terminals)"
    [ "${count:-0}" -gt 0 ] && echo "$count terminal(s) keep running in CCC's keeper; the next ccc shows them again. 'ccc stop --all' ends them."
    return 0
  fi
  count="$(running_terminals)"
  if ! $force && [ "${count:-0}" -gt 0 ] && ! sure_to_end_terminals "$count"; then
    echo "Nothing was stopped."
    return 1
  fi
  stop_server
  python3 "$KEEPER" stop
}

open_board() {
  local app
  for app in "Google Chrome" "Microsoft Edge"; do
    if [ -d "/Applications/$app.app" ]; then
      open -na "$app" --args --app="$URL" --new-window
      return
    fi
  done
  open "$URL"
}

wants_terminal_closed() {
  local answer
  read -r -n 1 -p "Close this terminal when the board opens? (y/n) " answer
  echo
  [[ "$answer" =~ ^[yY]$ ]]
}

main() {
  case "${1:-}" in
    stop)
      shift
      stop "$@"
      return
      ;;
    "") ;;
    *)
      echo "Usage: ccc [stop [--all] [--force]]" >&2
      return 2
      ;;
  esac

  if ! is_up; then
    if is_port_taken; then
      echo "Port $PORT is already in use by something else. Pick another with CCC_PORT=<port>." >&2
      return 1
    fi
    start_server || return 1
  fi

  local close=false
  if [ -t 0 ] && wants_terminal_closed; then close=true; fi
  open_board
  if $close; then return "$CLOSE_TERMINAL"; fi
  return 0
}

main "$@"
